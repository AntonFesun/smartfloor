# Port for the single Node server (Next.js + Socket.IO). Binds 0.0.0.0.
PORT=3000

# Absolute origin encoded in table QR codes.
# Use the LAN address phones and other laptops can reach. Do not leave this as
# localhost if guests join from another device.
# Example: APP_PUBLIC_URL=http://192.168.1.20:3000
# When unset, the server picks the first non-internal IPv4 and this port.
APP_PUBLIC_URL=

# Long-duration thresholds in milliseconds. Metrics and delay counts use only
# event timestamps; these values only decide what counts as a delay.
LONG_WAITER_MS=180000
LONG_PREP_MS=1200000
LONG_READY_MS=480000
LONG_OCCUPANCY_MS=5400000
